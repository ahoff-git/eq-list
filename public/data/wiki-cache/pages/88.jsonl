":"/Greaves_of_Forbidden_Rites"},{"text":"Boots of Forbidden Rites","item":"Boots of Forbidden Rites","wikiPath":"/Boots_of_Forbidden_Rites"}],"subQuests":[{"title":"Crown of Forbidden Rites","wikiPath":"/Cleric_Thurgadin_Armor_Quests","sources":[{"kind":"quest","where":"Thurgadin","detail":"Start zone"},{"kind":"quest","where":"Loremaster Dorinan","detail":"Quest giver"}],"components":[{"name":"Corroded Plate Helmet","qty":1,"wikiPath":"/Corroded_Plate_Helmet"},{"name":"Crushed Onyx Sapphire","qty":3,"wikiPath":"/Crushed_Onyx_Sapphire"}],"rewards":[{"text":"Crown of Forbidden Rites","item":"Crown of Forbidden Rites","wikiPath":"/Crown_of_Forbidden_Rites"}]},{"title":"Breastplate of Forbidden Rites","wikiPath":"/Cleric_Thurgadin_Armor_Quests","sources":[{"kind":"quest","where":"Thurgadin","detail":"Start zone"},{"kind":"quest","where":"Loremaster Dorinan","detail":"Quest giver"}],"components":[{"name":"Corroded Breastplate","qty":1,"wikiPath":"/Corroded_Breastplate"},{"name":"Black Marble","qty":3,"wikiPath":"/Black_Marble"}],"rewards":[{"text":"Breastplate of Forbidden Rites","item":"Breastplate of Forbidden Rites","wikiPath":"/Breastplate_of_Forbidden_Rites"}]},{"title":"Vambraces of Forbidden Rites","wikiPath":"/Cleric_Thurgadin_Armor_Quests","sources":[{"kind":"quest","where":"Thurgadin","detail":"Start zone"},{"kind":"quest","where":"Loremaster Dorinan","detail":"Quest giver"}],"components":[{"name":"Corroded Plate Vambraces","qty":1,"wikiPath":"/Corroded_Plate_Vambraces"},{"name":"Jaundice Gem","qty":3,"wikiPath":"/Jaundice_Gem"}],"rewards":[{"text":"Vambraces of Forbidden Rites","item":"Vambraces of Forbidden Rites","wikiPath":"/Vambraces_of_Forbidden_Rites"}]},{"title":"Bracers of Forbidden Rites","wikiPath":"/Cleric_Thurgadin_Armor_Quests","sources":[{"kind":"quest","where":"Thurgadin","detail":"Start zone"},{"kind":"quest","where":"Loremaster Dorinan","detail":"Quest giver"}],"components":[{"name":"Corroded Plate Bracer","qty":1,"wikiPath":"/Corroded_Plate_Bracer"},{"name":"Crushed Opal","qty":3,"wikiPath":"/Crushed_Opal"}],"rewards":[{"text":"Bracers of Forbidden Rites","item":"Bracers of Forbidden Rites","wikiPath":"/Bracers_of_Forbidden_Rites"}]},{"title":"Gauntlets of Forbidden Rites","wikiPath":"/Cleric_Thurgadin_Armor_Quests","sources":[{"kind":"quest","where":"Thurgadin","detail":"Start zone"},{"kind":"quest","where":"Loremaster Dorinan","detail":"Quest giver"}],"components":[{"name":"Corroded Plate Gauntlets","qty":1,"wikiPath":"/Corroded_Plate_Gauntlets"},{"name":"Crushed Lava Ruby","qty":3,"wikiPath":"/Crushed_Lava_Ruby"}],"rewards":[{"text":"Gauntlets of Forbidden Rites","item":"Gauntlets of Forbidden Rites","wikiPath":"/Gauntlets_of_Forbidden_Rites"}]},{"title":"Greaves of Forbidden Rites","wikiPath":"/Cleric_Thurgadin_Armor_Quests","sources":[{"kind":"quest","where":"Thurgadin","detail":"Start zone"},{"kind":"quest","where":"Loremaster Dorinan","detail":"Quest giver"}],"components":[{"name":"Corroded Plate Greaves","qty":1,"wikiPath":"/Corroded_Plate_Greaves"},{"name":"Chipped Onyx Sapphire","qty":3,"wikiPath":"/Chipped_Onyx_Sapphire"}],"rewards":[{"text":"Greaves of Forbidden Rites","item":"Greaves of Forbidden Rites","wikiPath":"/Greaves_of_Forbidden_Rites"}]},{"title":"Boots of Forbidden Rites","wikiPath":"/Cleric_Thurgadin_Armor_Quests","sources":[{"kind":"quest","where":"Thurgadin","detail":"Start zone"},{"kind":"quest","where":"Loremaster Dorinan","detail":"Quest giver"}],"components":[{"name":"Corroded Plate Boots","qty":1,"wikiPath":"/Corroded_Plate_Boots"},{"name":"Crushed Flame Emerald","qty":3,"wikiPath":"/Crushed_Flame_Emerald"}],"rewards":[{"text":"Boots of Forbidden Rites","item":"Boots of Forbidden Rites","wikiPath":"/Boots_of_Forbidden_Rites"}]}],"card":{"title":"Cleric Thurgadin Armor Quests","lines":["Minimum Level: 45","Classes: Cleric","Related Zones: Kael Drakkel","Related NPCs: Giants"]},"links":["Thurgadin","Loremaster Dorinan","Cleric","Kael Drakkel","Faction","Crown of Forbidden Rites","Breastplate of Forbidden Rites","Mark of Karn","Vambraces of Forbidden Rites","Bracers of Forbidden Rites","Abundant Food","Gauntlets of Forbidden Rites","Greaves of Forbidden Rites","Word of Health","Boots of Forbidden Rites","Abundant Drink","Corroded Plate Helmet","Crushed Onyx Sapphire","Corroded Breastplate","Black Marble","Corroded Plate Vambraces","Jaundice Gem","Corroded Plate Bracer","Crushed Opal","Corroded Plate Gauntlets","Crushed Lava Ruby","Corroded Plate Greaves","Chipped Onyx Sapphire","Corroded Plate Boots","Crushed Flame Emerald","Velious Class Armor","Coldain","Dain Frostreaver IV","Kromzek","Kromrif"],"dialogue":[{"npc":"Loremaster Dorinan","text":"Greetings to you. You are far away from your homelands, stranger. I am looking for someone. We here at the Temple of Lore are always seeking fellow priests of various faiths. Tell me, Erudite, are you a cleric?"},{"npc":"Loremaster Dorinan","text":"Those who are wise as we are know that protection of the head is most important. I may be able to forge you something most interesting if you were to bring me a Corroded Plate Helmet and three pieces of Crushed Onyx Sapphire."},{"npc":"Loremaster Dorinan","text":"If you find a corroded breastplate and three pieces of black marble bring them to me an I shall attempt to create an enchanted breastplate that will server you well."},{"npc":"Loremaster Dorinan","text":"Three Jaundice Gems and a set of Corroded Plate Vambraces might be an interesting combination. The powers of the gems may be harvested to imbue the vambraces."},{"npc":"Loremaster Dorinan","text":"Strong protection for one's hands is important. I may be able to craft you a set of powerful plate gauntlets if you find a set of Corroded Plate Gauntlets and three Crushed Lava Rubies."}],"fetchedAt":"2026-09-23T06:11:57.377Z","outOfEra":true}
