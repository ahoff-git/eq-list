te":"2%"},{"name":"Talisman of the Serpent","qty":1,"wikiPath":"/Talisman_of_the_Serpent","dropRate":"2%"},{"name":"Unfailing Reverence","qty":1,"wikiPath":"/Unfailing_Reverence","dropRate":"2%"},{"name":"Pox of Bertoxxulous","qty":1,"wikiPath":"/Pox_of_Bertoxxulous","dropRate":"2%"},{"name":"Talisman of the Raptor","qty":1,"wikiPath":"/Talisman_of_the_Raptor","dropRate":"2%"},{"name":"Voice of the Berserker","qty":1,"wikiPath":"/Voice_of_the_Berserker","dropRate":"2%"},{"name":"Levant","qty":1,"wikiPath":"/Levant","dropRate":"2%"},{"name":"Conjure Corpse","qty":1,"wikiPath":"/Conjure_Corpse","dropRate":"2%"},{"name":"Quivering Veil of Xarn","qty":1,"wikiPath":"/Quivering_Veil_of_Xarn","dropRate":"2%"},{"name":"Emissary of Thule","qty":1,"wikiPath":"/Emissary_of_Thule","dropRate":"2%"},{"name":"Devouring Darkness","qty":1,"wikiPath":"/Devouring_Darkness","dropRate":"2%"},{"name":"Markar`s Discord","qty":1,"wikiPath":"/Markar%60s_Discord","dropRate":"2%"},{"name":"Retribution of Al`Kabor","qty":1,"wikiPath":"/Retribution_of_Al%60Kabor","dropRate":"2%"},{"name":"Pillar of Flame","qty":1,"wikiPath":"/Pillar_of_Flame","dropRate":"2%"},{"name":"Evacuate","qty":1,"wikiPath":"/Evacuate","dropRate":"2%"},{"name":"Invert Gravity","qty":1,"wikiPath":"/Invert_Gravity","dropRate":"2%"},{"name":"Vengeance of Al`Kabor","qty":1,"wikiPath":"/Vengeance_of_Al%60Kabor","dropRate":"2%"},{"name":"Flaming Sword of Xuzl","qty":1,"wikiPath":"/Flaming_Sword_of_Xuzl","dropRate":"2%"},{"name":"Velocity","qty":1,"wikiPath":"/Velocity","dropRate":"2%"},{"name":"Summon: Muzzle of Mardu","qty":1,"wikiPath":"/Summon:_Muzzle_of_Mardu","dropRate":"2%"},{"name":"Dyzil`s Deafening Decoy","qty":1,"wikiPath":"/Dyzil%60s_Deafening_Decoy","dropRate":"2%"},{"name":"Manastorm","qty":1,"wikiPath":"/Manastorm","dropRate":"2%"},{"name":"Torment of Argli","qty":1,"wikiPath":"/Torment_of_Argli","dropRate":"2%"},{"name":"Umbra","qty":1,"wikiPath":"/Umbra","dropRate":"2%"},{"name":"Forlorn Deeds","qty":1,"wikiPath":"/Forlorn_Deeds","dropRate":"2%"},{"name":"Enlightenment","qty":1,"wikiPath":"/Enlightenment","dropRate":"2%"},{"name":"Bedlam","qty":1,"wikiPath":"/Bedlam","dropRate":"2%"},{"name":"Gift of Pure Thought","qty":1,"wikiPath":"/Gift_of_Pure_Thought","dropRate":"2%"},{"name":"Asphyxiate","qty":1,"wikiPath":"/Asphyxiate","dropRate":"2%"},{"name":"Sedulous Subversion","qty":1,"wikiPath":"/Sedulous_Subversion","dropRate":"2%"},{"name":"Eye of Tallon","qty":1,"wikiPath":"/Eye_of_Tallon","dropRate":"2%"},{"name":"Wake of Karana","qty":1,"wikiPath":"/Wake_of_Karana","dropRate":"2%"},{"name":"Manasink","qty":1,"wikiPath":"/Manasink","dropRate":"2%"},{"name":"Augment","qty":1,"wikiPath":"/Augment","dropRate":"2%"},{"name":"Bonds of Tunare","qty":1,"wikiPath":"/Bonds_of_Tunare","dropRate":"2%"},{"name":"Cannibalize IV","qty":1,"wikiPath":"/Cannibalize_IV","dropRate":"2%"},{"name":"Carnelian","qty":1,"wikiPath":"/Carnelian","dropRate":"10%"},{"name":"Fire Opal","qty":1,"wikiPath":"/Fire_Opal","dropRate":"10%"},{"name":"Star Ruby","qty":1,"wikiPath":"/Star_Ruby","dropRate":"10%"},{"name":"Fire Emerald","qty":1,"wikiPath":"/Fire_Emerald","dropRate":"10%"},{"name":"Sapphire","qty":1,"wikiPath":"/Sapphire","dropRate":"10%"},{"name":"Ruby","qty":1,"wikiPath":"/Ruby","dropRate":"10%"},{"name":"Black Sapphire","qty":1,"wikiPath":"/Black_Sapphire","dropRate":"10%"},{"name":"Diamond","qty":1,"wikiPath":"/Diamond","dropRate":"10%"},{"name":"Blue Slumber Fungus","qty":1,"wikiPath":"/Blue_Slumber_Fungus","dropRate":"10%"},{"name":"Blue Diamond","qty":1,"wikiPath":"/Blue_Diamond","dropRate":"10%"},{"name":"Clarifying Spores","qty":1,"wikiPath":"/Clarifying_Spores","dropRate":"35%"},{"name":"Spores of Forgetfulness","qty":1,"wikiPath":"/Spores_of_Forgetfulness","dropRate":"10%"}],"rewards":[],"card":{"title":"Myconid priest","lines":["Race: Fungusman","Class: Cleric","Level: 54","Zone: Old Sebilis","Location: See Discussion","AC: 462","HP: 12750 (6)","Damage per hit: 78 - 212","Attacks per 