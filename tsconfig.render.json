{
  "//": "Compiles the renderer to CommonJS so scripts/render-check.mjs can server-render real components (npm run test:render).",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".render-check",
    "rootDir": "src",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "jsx": "react-jsx",
    "isolatedModules": false,
    "incremental": false,
    "declaration": false,
    "sourceMap": false,
    "plugins": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.*"]
}
