# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# electron
/dist-electron/
/release/

# log replay output (see scripts/replay-log.mjs)
/replay-logs/

# generated travel graphs (see scripts/build-travel-graph.mjs) — built from *your* map pack, so
# they're a per-install artifact rather than shared data. The hand-authored half is in
# src/shared/travel/manual-links.ts and is committed.
/data/

# the web build's static data snapshot (see scripts/build-web-snapshot.mjs). Only the map files are
# ignored here: your own EverQuest install's files plus a third-party pack, ~215 MB and not obviously
# ours to redistribute — a hosted deployment goes without maps until there's a real plan for that.
# wiki-cache/, lucy-cache/, travel/ and manifest.json ARE committed (see "Publishing" in the script's
# own doc comment) — they're a mirror of public wiki pages, small, and genuinely ours to ship.
/public/data/maps/
/scripts/web-snapshot.log

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# A machine-local pointer at a real EQ Legends install, for the opt-in `*.live.test.ts` checks
# (see electron/tests/game-data.ts). Holds an absolute path, so it is yours and never ours.
/fixtures/local-game-dir.txt
